{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/tool/hub-guard.sh\" --precompact",
            "timeout": 15,
            "statusMessage": "Hub kaydı güncel mi?"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/tool/hub-guard.sh\" --session-start",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
